<section class="section"><div class="page-width"><div class="section-head"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="display">{{ section.settings.heading }}</h2></div>{% if section.settings.collection %}<a class="text-link" href="{{ section.settings.collection.url }}">Shop all</a>{% endif %}</div>
<div class="product-grid">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for i in (1..4) %}<article class="product-card"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder' }}</div><div class="product-card__info"><h3>Celebration essential</h3><span class="price">$48.00</span></div></article>{% endfor %}{% endif %}</div></div></section>
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The opening round"},{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":4,"max":8,"step":4,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}
