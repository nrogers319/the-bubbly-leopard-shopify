<header class="site-header">
  <div class="header-inner page-width">
    <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu">Menu</button>
    <div class="header-utility header-utility--left"><button class="header-icon" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu"><span aria-hidden="true">☰</span><span class="visually-hidden">Open menu</span></button></div>
    <a class="header-logo" href="{{ routes.root_url }}">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: 520 | image_tag: widths: '180,260,360,520', alt: shop.name }}
      {% else %}
        <img src="{{ 'the-bubbly-leopard-logo.png' | asset_url }}" width="520" height="347" alt="{{ shop.name | escape }}">
      {% endif %}
    </a>
    <div class="header-actions"><a class="header-icon" href="{{ routes.search_url }}" aria-label="Search">⌕</a><a class="hide-mobile" href="{{ routes.account_url }}">Account</a><a href="{{ routes.cart_url }}">Bag <span class="cart-count">{{ cart.item_count }}</span></a></div>
  </div>
  <nav class="header-nav page-width" aria-label="Primary">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
  </nav>
  <nav id="MobileMenu" class="mobile-menu" data-mobile-menu aria-label="Mobile">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
  </nav>
</header>
{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Replacement logo","info":"The approved Bubbly Leopard logo is used automatically when this is left blank."},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}
