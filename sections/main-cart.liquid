<section class="section page-width"><div class="section-head"><h1 class="display">Your bag</h1></div>{% if cart.empty? %}<div class="empty-state"><p>Your bag is ready for something bubbly.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop all</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<div style="display:grid;grid-template-columns:100px 1fr auto;gap:20px;padding:20px 0;border-bottom:1px solid var(--line)">{{ item.image | image_url: width: 240 | image_tag }}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div>{{ item.variant.title }}</div><input style="width:70px;margin-top:10px" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}</div><div style="max-width:420px;margin:40px 0 0 auto;text-align:right"><h2>Subtotal: {{ cart.total_price | money }}</h2><p>Shipping and taxes calculated at checkout.</p><button class="button" name="update">Update bag</button> <button class="button" name="checkout">Checkout</button></div></form>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
