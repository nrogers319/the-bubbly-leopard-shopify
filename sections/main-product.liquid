<section class="main-product page-width"><div class="product-gallery">{% for media in product.media %}{{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}</div><div class="product-info"><span class="eyebrow">The Bubbly Leopard</span><h1 class="display">{{ product.title }}</h1><div class="product-price">{{ product.selected_or_first_available_variant.price | money }}</div>
{% form 'product', product, class: 'product-form' %}<label for="Variant">Choose your option</label><select id="Variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" value="1" min="1"><button class="button button--full" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}
<div class="product-details rte">{{ product.description }}</div></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
