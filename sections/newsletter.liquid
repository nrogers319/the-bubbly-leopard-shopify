<section class="newsletter section"><div class="page-width"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="display">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">Join the guest list →</button>{% endform %}</div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"You’re invited"},{"type":"text","id":"heading","label":"Heading","default":"Join the guest list."},{"type":"textarea","id":"text","label":"Text","default":"First dibs on new drops, party plans, and the occasional excuse to celebrate."}],"presets":[{"name":"Newsletter"}]}{% endschema %}
