<header class="collection-header"><span class="eyebrow">Find your favorite</span><h1 class="display">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header><div class="page-width collection-grid"><div class="product-grid">{% paginate collection.products by 24 %}{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}{% for i in (1..4) %}{% render 'demo-product-card', index: i %}{% endfor %}{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></div>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
