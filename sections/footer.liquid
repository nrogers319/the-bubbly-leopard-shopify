<footer class="footer"><div class="page-width"><div class="footer-grid">
  <div class="footer-brand-wrap"><div class="footer-brand">The Bubbly Leopard</div><p>Good taste. Great stories. Always worth celebrating.</p></div>
  {% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.heading }}</h3><ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>{% endfor %}
</div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>Raise a glass to being exactly who you are.</span></div></div></footer>
{% schema %}{"name":"Footer","max_blocks":2,"blocks":[{"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]}],"presets":[{"name":"Footer","blocks":[{"type":"menu"},{"type":"menu"}]}]}{% endschema %}
