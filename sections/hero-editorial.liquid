<section class="hero">
  <div class="hero-copy"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1 class="display">{{ section.settings.heading }}</h1><span class="hero-rule" aria-hidden="true"></span><p>{{ section.settings.text }}</p><a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
  <div class="hero-media"><div class="hero-media__frame">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '600,900,1200,1800', sizes: '(max-width: 900px) 100vw, 50vw' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div><span class="hero-note">Made for moments that matter</span></div>
</section>
{% schema %}{"name":"Editorial hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"For life’s most unforgettable moments"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Dress for the toast."},{"type":"textarea","id":"text","label":"Text","default":"Effortless looks for birthdays, brunches, girls’ trips, and every beautifully unnecessary reason to celebrate."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the first pour"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image","label":"Lifestyle image"}],"presets":[{"name":"Editorial hero"}]}{% endschema %}
